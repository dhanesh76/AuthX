# =========================
# DATABASE
# =========================

# PostgreSQL database name, user, and password — used by Flyway and JPA
DB_USER=
DB_PASSWORD=
DB_NAME=authx

# =========================
# REDIS
# =========================

# Redis authentication password
REDIS_PASSWORD=

# =========================
# JWT
# =========================

# HMAC-SHA256 signing secret — minimum 32 characters, keep this secret
JWT_SECRET=
# Token lifetimes in Spring Duration format (e.g. 5m, 1h, 7d)
JWT_ACCESS_TTL=5m
JWT_FLOW_TTL=5m
JWT_REAUTH_TTL=15m

# =========================
# OTP
# =========================

# How long an OTP remains valid before expiring
OTP_TTL=5m

# =========================
# GOOGLE OAUTH
# =========================

# Obtain from https://console.cloud.google.com — OAuth 2.0 credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# =========================
# GITHUB OAUTH
# =========================

# Obtain from https://github.com/settings/developers — OAuth Apps
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# =========================
# MAIL
# =========================

# SMTP configuration for sending OTP emails
# Gmail: use an App Password, not your account password
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# =========================
# TURNSTILE
# =========================

# Obtain from https://dash.cloudflare.com — Turnstile
# For local development use the always-pass test key: 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=
# The hostname Cloudflare will verify against — must match your domain
# For local development with test keys use: example.com
TURNSTILE_EXPECTED_HOST=